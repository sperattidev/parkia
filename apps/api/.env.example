# Copiar a .env para desarrollo local. Nunca commitear .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Base de datos local (compose.yaml en la raíz del repo)
DATABASE_URL=postgres://parkia:parkia@localhost:5433/parkia

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:3001

# Clave para firmar tokens y códigos (mínimo 32 caracteres).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=solo-para-desarrollo-cambiar-en-produccion-0000

# Envío de emails: "consola" (desarrollo, muestra el código en el log) o "resend".
CORREO_PROVEEDOR=consola
# RESEND_API_KEY=
# CORREO_REMITENTE=Parkia <no-responder@parkia.net.ar>
