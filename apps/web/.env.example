# Copiar a .env.local para desarrollo. Nunca commitear .env.local.

# URL de la API vista desde el servidor de Next (nunca se expone al navegador).
PARKIA_API_URL=http://localhost:3000

# Estilo del mapa (MapLibre). OpenFreeMap: teselas vectoriales libres, sin clave.
NEXT_PUBLIC_ESTILO_MAPA=https://tiles.openfreemap.org/styles/liberty

# Entorno de negocio (igual que en la API): desarrollo, demo o produccion.
# Fuera de produccion se habilitan las cargas de saldo sin pago real.
PARKIA_ENTORNO=desarrollo
