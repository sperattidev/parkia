{
  "name": "@parkia/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Esquemas Zod compartidos entre la API y los clientes de Parkia",
  "license": "UNLICENSED",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
