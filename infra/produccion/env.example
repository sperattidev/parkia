# /opt/parkia/.env en la VPS (permisos 600). Nunca commitear valores reales.

# Entorno de negocio: demo (cargas de prueba habilitadas) o produccion.
PARKIA_ENTORNO=demo

# Generados en la VPS por infra/preparar-vps.sh.
POSTGRES_PASSWORD=
AUTH_SECRET=

# Token del túnel creado en Cloudflare Zero Trust (lo carga el responsable de la cuenta).
CLOUDFLARE_TUNNEL_TOKEN=

# Emails: "consola" (solo demo: los códigos quedan en el log) o "resend".
CORREO_PROVEEDOR=consola
RESEND_API_KEY=
CORREO_REMITENTE=Parkia <no-responder@parkia.net.ar>
